# =============================================================================
# nse-data-service — environment template
# =============================================================================
# Copy to `.env` and fill in. `.env` is gitignored; this template is committed.
#   cp .env.example .env && nano .env
#
# The collector loads this file automatically (python-dotenv) and systemd reads
# it via `EnvironmentFile=` (see deploy/*.service).
#
# Only the variables below are actually read by the code. Two things people
# expect to set here are NOT env vars — read the notes at the bottom:
#   • the SQLite DB path is hardcoded to data/nse.db (relative to the process CWD)
#   • Redis connects to the default localhost:6379 (no URL variable)
# =============================================================================


# -----------------------------------------------------------------------------
# Azure OpenAI — LLM-assisted announcement/financial labeling & parsers
# -----------------------------------------------------------------------------
# Used by the PDF/parser + label-drafting scripts. The core collector loop runs
# without these; leave blank if you are not running LLM labeling yet.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT_NAME=
# Embedding deployment (present in current .env; optional unless embeddings used)
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=


# -----------------------------------------------------------------------------
# Groww broker — historical intraday backfill (scripts/backfill_intraday.py)
# -----------------------------------------------------------------------------
# Optional. Only needed for broker-sourced intraday/minute backfills, NOT for
# the live NSE collectors. Two ways to authenticate (see brokers/groww.py):
#
#   A) Direct token — paste a current access token, skips TOTP login:
# GROWW_ACCESS_TOKEN=
#
#   B) Key + secret + TOTP — generates the token on demand (preferred for a
#      long-running host, since direct tokens expire):
GROWW_API_KEY=
GROWW_API_SECRET=
GROWW_TOTP_SECRET=


# -----------------------------------------------------------------------------
# Zerodha Kite broker — alternative intraday backfill source (brokers/kite.py)
# -----------------------------------------------------------------------------
# Optional. Only set if you use Kite instead of / alongside Groww.
# KITE_API_KEY=
# KITE_ACCESS_TOKEN=


# -----------------------------------------------------------------------------
# Telegram — alert dispatcher  (NOT WIRED YET — arrives in Phase 1, Week 5)
# -----------------------------------------------------------------------------
# Placeholders only. No code reads these today; bot/dispatcher.py (task 5.6/5.7)
# will. Listed here so the VPS .env is ready before Week 5 and so this template
# matches checklist task 1.5 ("all API keys").
# TELEGRAM_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_OPS_CHAT_ID=     # separate ops channel for collector-failure alerts (task 6.3)


# =============================================================================
# NOTES — things that are configured OUTSIDE this file
# =============================================================================
#
# DATABASE PATH
#   Hardcoded to "data/nse.db", relative to the working directory of the
#   process (main.py). On the VPS the systemd unit sets
#   WorkingDirectory=/opt/nse-data-service, so the DB lives at
#   /opt/nse-data-service/data/nse.db. There is no DB_PATH env var — to move
#   the DB, change WorkingDirectory in the unit (or the path in main.py).
#
# REDIS
#   main.py calls redis.Redis(decode_responses=True) with no arguments, i.e. it
#   connects to localhost:6379, db 0. There is no REDIS_URL variable. If Redis
#   is unreachable the collector logs `dedup_cache_redis_unavailable` and falls
#   back to an in-process memory cache — so Redis is an optimization, not a hard
#   dependency. Install it on the VPS and enable it on boot (see docs/DEPLOY.md).
#   To point at a non-default Redis, edit make_dedup_cache() in main.py.
# =============================================================================
